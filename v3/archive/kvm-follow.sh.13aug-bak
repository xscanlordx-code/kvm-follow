#!/bin/bash
# kvm-follow — монитор следует за клавиатурой MX Keys Mini.
#
# МЕХАНИЗМ. Монитор (LG UltraWide, семейство WQ) НЕ слушает стандартный VCP 0x60:
# все коды из его же capabilities (17/18/15) вход не меняют, дают лишь мерцание.
# Вход у новых LG переключается ПРОПРИЕТАРНЫМ регистром 0xF4, отправленным на I2C
# адрес 0x50 вместо 0x51 — в m1ddc это команда `set input-alt`.
# ВАЖНО: brew-релиз m1ddc 1.2.0 эту команду имеет, но она СЛОМАНА (неверная
# контрольная сумма и обнулённый старший байт значения). Нужен HEAD (PR #52).
# Здесь используется бинарник HEAD, собранный на макбуке: ~/bin/m1ddc.
# Коды проверены вживую: 144 (0x90) = HDMI = Mac mini, 465 (0x01D1) = USB-C = макбук.
# Старший байт 0x01 в 465 — как раз то, что обрезала сломанная версия.
#
# Гашение экранов, прогрев и ожидание автопоиска больше не нужны: раньше это был
# обходной путь вокруг «неработающего» DDC. Переключение теперь ~1-2 с вместо 12-20.
#
# ДЕТЕКТ. Только на Mac mini: blueutil по ИМЕНИ устройства (по MAC-адресу blueutil
# ошибочно отдаёт 0). На макбуке клавиатура приходит через Bolt, а ресивер держит
# 3 HID-интерфейса постоянно — ioreg/hidutil не меняются, детектировать нечем.

KB="MX Keys Mini"
IN_MINI=144            # HDMI  (0x90)  — Mac mini
IN_MB=465              # USB-C (0x1D1) — макбук

MB_USER="semenmoshkin"
MB_HOSTS=("MacBook-Pro-2.local" "192.168.0.118")
SSH_KEY="/Users/semenmoshkin/.ssh/kvm_macbook"

POLL=0.3               # период опроса
SETTLE=0.3             # подтверждение против дребезга BT

DDC="/Users/semenmoshkin/bin/m1ddc"        # HEAD-сборка, с рабочим input-alt
MB_DDC="/opt/homebrew/bin/m1ddc"           # на макбуке тоже HEAD
BLUEUTIL=/opt/homebrew/bin/blueutil
LOG=/tmp/kvm-follow.log

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

SSH_OPTS=(-i "$SSH_KEY" -o ConnectTimeout=5 -o BatchMode=yes
          -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
          -o ControlMaster=auto -o ControlPath=/tmp/kvm-ssh-%h -o ControlPersist=900)

MB_ACTIVE=""

mb_ssh() {
  local h
  for h in "${MB_ACTIVE}" "${MB_HOSTS[@]}"; do
    [ -z "$h" ] && continue
    if ssh "${SSH_OPTS[@]}" "$MB_USER@$h" "$1" >/dev/null 2>&1; then
      MB_ACTIVE="$h"; return 0
    fi
  done
  MB_ACTIVE=""; return 1
}

# Разбудить макбук и удержать его дисплей, пока мы на нём: иначе монитор переключится
# на USB-C и покажет чёрный экран. -u будит (с -t 1 не будит вообще), -d удерживает —
# powerd иначе отпускает дисплей уже через 30 секунд.
# Удержание НЕ снимаем при возврате: пусть макбук всегда стоит готовым, тогда
# перед переключением не нужно ждать его пробуждения — это экономит ~1.5 с.
mb_wake() { mb_ssh "nohup caffeinate -u -t 5 >/dev/null 2>&1 & pgrep -f 'caffeinate -d' >/dev/null || nohup caffeinate -d >/dev/null 2>&1 &"; }

# LG иногда глотает первую команду — шлём дважды.
ddc_local() { "$DDC" set input-alt "$1" >/dev/null 2>&1; sleep 0.15; "$DDC" set input-alt "$1" >/dev/null 2>&1; }
ddc_remote() { mb_ssh "$MB_DDC set input-alt $1"; }

probe() { "$BLUEUTIL" --is-connected "$KB" 2>/dev/null; }

mb_ssh 'true' && log "SSH-мастер поднят: $MB_ACTIVE" || log "макбук недоступен"

state=$(probe)
case "$state" in 0|1) ;; *) state=1 ;; esac
log "старт, состояние=$state"

while true; do
  sleep "$POLL"
  now=$(probe)
  case "$now" in 0|1) ;; *) continue ;; esac
  [ "$now" = "$state" ] && continue

  t0=$(date +%s)
  sleep "$SETTLE"
  confirm=$(probe)
  [ "$confirm" != "$now" ] && { log "дребезг ($state->$now->$confirm), игнор"; continue; }
  state=$now

  if [ "$now" = "0" ]; then
    # ушли на макбук: сначала разбудить его, иначе на USB-C будет чернота
    if mb_wake; then
      ddc_local "$IN_MB"
      log "[уход] монитор -> USB-C за $(( $(date +%s) - t0 ))с"
    else
      log "[уход] макбук не отвечает по SSH — монитор НЕ трогаю"
    fi
  else
    # вернулись: Mac mini не спит и всегда рисует, будить нечего.
    # Шлём и локально, и с макбука — если mini потерял DDC-канал, сработает второй.
    ddc_local "$IN_MINI"
    ddc_remote "$IN_MINI" &
    log "[возврат] монитор -> HDMI за $(( $(date +%s) - t0 ))с"
  fi
done
