#!/bin/bash
# kvm-follow — монитор следует за клавиатурой MX Keys Mini.
#
# МЕХАНИЗМ. Монитор (LG UltraWide, семейство WQ) НЕ слушает стандартный VCP 0x60:
# все коды из его же capabilities (17/18/15) вход не меняют, дают лишь мерцание.
# Вход у новых LG переключается ПРОПРИЕТАРНЫМ регистром 0xF4, отправленным на I2C
# адрес 0x50 вместо 0x51 — в m1ddc это команда `set input-alt`.
# ВАЖНО: brew-релиз m1ddc 1.2.0 эту команду имеет, но она СЛОМАНА (неверная
# контрольная сумма и обнулённый старший байт значения). Нужен HEAD (PR #52).
# Здесь используется бинарник HEAD, собранный на макбуке: ~/bin/m1ddc.
# Коды проверены вживую: 144 (0x90) = HDMI, 465 (0x01D1) = USB-C. Какая машина на каком входе —
# см. IN_MINI/IN_MB ниже, это единственное место, где раскладка задаётся.
# Старший байт 0x01 в 465 — как раз то, что обрезала сломанная версия.
#
# Гашение экранов, прогрев и ожидание автопоиска больше не нужны: раньше это был
# обходной путь вокруг «неработающего» DDC. Переключение теперь ~1-2 с вместо 12-20.
#
# ДЕТЕКТ. Только на Mac mini: blueutil по ИМЕНИ устройства (по MAC-адресу blueutil
# ошибочно отдаёт 0). На макбуке клавиатура приходит через Bolt, а ресивер держит
# 3 HID-интерфейса постоянно — ioreg/hidutil не меняются, детектировать нечем.

KB="MX Keys Mini"
# РАСКЛАДКА: Mac mini на HDMI, MacBook на USB-C.
# 14.08 кабели временно меняли местами и вернули обратно. Обоснование «на USB-C mini терял
# треть DDC-команд (28 из 40 против 40 из 40 по HDMI)» ОТОЗВАНО: замер 14.08 в 21:53
# одновременно с обеих машин дал 24/40 верных ответов по HDMI и 23/40 по USB-C — разницы нет,
# а «40 из 40» было кодом возврата m1ddc, который равен 0 всегда (см. ddc_local).
# Настоящее основание держать mini на HDMI: разные входы монитора отдают РАЗНЫЕ EDID
# (ProductID 0x7794 на HDMI против 0x7796 на USB-C), macOS помнит разрешение для каждого
# отдельно, и на HDMI-identity у mini записаны честные 2560x1080@100. Менять раскладку —
# значит заново получить чистый identity и риск сесть на безопасные 1920x1080@60.
IN_MINI=144            # HDMI  (0x90)  — Mac mini
IN_MB=465              # USB-C (0x1D1) — макбук

MB_USER="semenmoshkin"
MB_HOSTS=("MacBook-Pro-2.local" "192.168.0.118")
SSH_KEY="/Users/semenmoshkin/.ssh/kvm_macbook"

POLL=0.3               # период опроса
SETTLE=0.3             # подтверждение против дребезга BT

DDC="/Users/semenmoshkin/bin/m1ddc"        # HEAD-сборка, с рабочим input-alt
MB_DDC="/opt/homebrew/bin/m1ddc"           # на макбуке тоже HEAD
BLUEUTIL=/opt/homebrew/bin/blueutil
LOG=/tmp/kvm-follow.log
STATEFILE=/tmp/kvm-follow.state            # последнее выставленное состояние, против флапа при рестарте

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# ServerAlive* обязательны с тех пор, как макбуку разрешено спать: ConnectTimeout покрывает
# только установление соединения, а сеанс через УЖЕ ЖИВОЙ мастер-сокет к уснувшему хосту висит
# неограниченно и заморозил бы весь цикл. Теперь такой сеанс отваливается за 8-13 с (замерено).
# ControlPersist укорочен со 15 минут до 2: меньше шансов наткнуться на протухший сокет.
SSH_OPTS=(-i "$SSH_KEY" -o ConnectTimeout=5 -o BatchMode=yes
          -o ServerAliveInterval=3 -o ServerAliveCountMax=2
          -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
          -o ControlMaster=auto -o ControlPath=/tmp/kvm-ssh-%h -o ControlPersist=120)

MB_ACTIVE=""

mb_ssh() {
  local h
  for h in "${MB_ACTIVE}" "${MB_HOSTS[@]}"; do
    [ -z "$h" ] && continue
    if ssh "${SSH_OPTS[@]}" "$MB_USER@$h" "$1" >/dev/null 2>&1; then
      MB_ACTIVE="$h"; return 0
    fi
  done
  MB_ACTIVE=""; return 1
}

# ─── УДЕРЖАНИЕ ДИСПЛЕЯ МАКБУКА ───────────────────────────────────────────────
# ЧТО ИЗМЕНЕНО 14.08 ВЕЧЕРОМ И ПОЧЕМУ.
#
# 1) ЧТО НА САМОМ ДЕЛЕ ДЕЛАЕТ caffeinate -s. Прежний комментарий утверждал, что эта ассерция
#    ОТКЛЮЧАЕТ сон по закрытой крышке, и ссылался на powerd 19:24:33 «Created PreventSystemSleep».
#    Ссылка неверна дважды: (а) ассерцию там держал WindowServer.521 («... "com.apple.WindowServer.PUIDS"»),
#    первый caffeinate с PreventSystemSleep появился только в 21:32:53; (б) в 19:24 макбук был
#    НА БАТАРЕЕ («19:15:11 Battery capacity change ... Source:Batt», переход на AC в 21:25:17),
#    а -s по man действителен лишь на питании.
#    Решение powerd о clamshell -s не меняет: терм «assertions» в этой формуле считает только
#    ассерции со свойством AppliesOnLidClose, а его powerd выдаёт по энтайтлменту
#    com.apple.private.iokit.assertonlidclose. У /usr/bin/caffeinate энтайтлментов нет вовсе
#    (codesign -d --entitlements -), рутовому bluetoothd powerd тоже отказывает:
#    «Pid 513 is not privileged to set property AppliesOnLidClose». Поэтому строка
#    «EvaluateClamshell. Disable : 0 ... assertions 0» появляется при живом caffeinate -s тоже.
#    НО -s МЕНЯЕТ ИСХОД, и это подтверждено вживую 14.08:
#      без -s:  21:34:11.033 «Turning off display for Clamshell Sleep»
#            -> 21:34:16.069 «Entering SLEEP state due to 'Clamshell Sleep'»  (SSH мёртв, задачи стоят)
#      с  -s:  22:58:39.208, 23:00:13.256, 23:01:40.859 «Turning off display for Clamshell Sleep»
#            -> в ту же миллисекунду «Entering DARKWAKE state due to 'Clamshell Sleep'»
#               (SSH жив — опрос с mini отвечал всё это время, фоновые задачи работают)
#    Три случая из трёх против одного из одного. То есть -s не даёт погаснуть — он не даёт УСНУТЬ.
#    Экран при уходе монитора гаснет в любом случае: это решает потеря внешнего дисплея, а не мы.
#    ВЫВОД: -s нужен и остаётся. Именно он превращает «уснул» в «работает с погашенным экраном».
#
# 2) Оба удержания теперь ОДИН самоистекающий процесс `caffeinate -d -s -t HOLD_TTL`.
#    Проверено на макбуке: один такой процесс создаёт сразу обе ассерции —
#    «pid 49988(caffeinate): PreventUserIdleDisplaySleep ... asserting for 6 secs» и
#    «pid 49988(caffeinate): PreventSystemSleep ... asserting for 6 secs». Один pid — одна уборка.
#
# 3) Удержание САМОИСТЕКАЮЩЕЕ и продлевается, пока макбук на питании.
#    Раньше оно ставилось бессрочно и снималось по SSH при возврате. Но к моменту возврата
#    макбук как раз засыпает, SSH не проходит, и удержание остаётся сиротой: замерено 14.08
#    ровно 2 ч 07 мин 43 с (Created 19:20:14.675886 -> ClientDied 21:27:57.709649; в прежнем
#    комментарии стояло «45 минут» — занижено втрое). Живой -d на батарее не даёт ноутбуку
#    уснуть вовсе (он тянет за собой powerd «Prevent sleep while display is on»), а на батарее
#    `pmset -g custom` задаёт sleep 1 / displaysleep 10 — то есть сирота возвращает ровно тот
#    слив 4,5-6,3 %/ч, ради которого снимали SleepDisabled=1.
#    Теперь сирота живёт максимум HOLD_TTL секунд и умирает сама, без всякого SSH.
#    Прежнее возражение против самоистекающего -t 900 («сеансов длиннее 15 минут 7 из 60»)
#    снято продлением: mini продлевает удержание каждые HOLD_RENEW секунд.
#
# 4) Удержание больше НЕ снимается при возврате на mini. Оно снимается по ПРОПАЖЕ ПИТАНИЯ —
#    это и есть настоящее условие «макбук уехал». Пока он в доке, дисплей держим всегда:
#    иначе через 30 минут простоя (на AC displaysleep=30) экран гаснет по таймеру, а гашение
#    дисплея — второй путь в clamshell-сон (в логах 19 пар «Display is turned off ->
#    Clamshell Sleep», 11 из них на питании). Отвязка от возврата и есть то, что превращает
#    «не спит, пока показывает картинку» в «не спит в доке никогда».
HOLD_TTL=90                    # срок жизни удержания на макбуке, с
HOLD_RENEW=40                  # период продления, пока мы за макбуком (должен быть < HOLD_TTL/2)
HOLD_PID=/tmp/kvm-hold.pid     # файл с pid удержания — НА МАКБУКЕ

# Поставить или продлить удержание дисплея. Новое ставим ДО убийства старого,
# чтобы не было окна без удержания. Без pkill -f: шаблон подстроки матчит удалённые шеллы
# параллельных ssh-сеансов (проверено), и наложившиеся вызовы убивали удержание друг у друга.
# ГЕЙТ ПО ПИТАНИЮ обязателен: если владелец унёс макбук, не возвращая клавиатуру на mini,
# состояние здесь так и останется 0, и mini продлевал бы удержание при каждом появлении
# макбука в сети — то есть не давал бы ему спать где угодно. На батарее удержание не ставим.
mb_hold() {
  mb_ssh "pmset -g batt | grep -q 'AC Power' || { p=\$(cat $HOLD_PID 2>/dev/null); [ -n \"\$p\" ] && kill \"\$p\" 2>/dev/null; rm -f $HOLD_PID; exit 0; }
          old=\$(cat $HOLD_PID 2>/dev/null)
          nohup caffeinate -d -s -t $HOLD_TTL >/dev/null 2>&1 &
          echo \$! > $HOLD_PID
          [ -n \"\$old\" ] && kill \"\$old\" 2>/dev/null
          exit 0"
}

# Разбудить макбук и сразу поставить удержание. -u будит (с -t 1 не будит вообще).
mb_wake() {
  mb_ssh "nohup caffeinate -u -t 5 >/dev/null 2>&1 &
          pmset -g batt | grep -q 'AC Power' || { p=\$(cat $HOLD_PID 2>/dev/null); [ -n \"\$p\" ] && kill \"\$p\" 2>/dev/null; rm -f $HOLD_PID; exit 0; }
          old=\$(cat $HOLD_PID 2>/dev/null)
          nohup caffeinate -d -s -t $HOLD_TTL >/dev/null 2>&1 &
          echo \$! > $HOLD_PID
          [ -n \"\$old\" ] && kill \"\$old\" 2>/dev/null
          exit 0"
}

# mb_release УДАЛЁН НАМЕРЕННО. Он снимал удержание при возврате на mini — то есть ровно тогда,
# когда макбук нужно оставить в живых. Его функцию теперь несут две вещи, обе надёжнее SSH:
#   — гейт по питанию внутри mb_hold (пропал адаптер — удержание убито и не ставится заново);
#   — HOLD_TTL (никакое удержание не живёт дольше 90 с без продления с mini).
# Прежние четыре ретрая по 5 с не помогали по построению: макбук в момент возврата как раз
# засыпал, SSH не проходил, и удержание оставалось сиротой — замерено 2 ч 07 мин 43 с.

# Побудка в фоне с повторами. Спящий макбук по сети не разбудить (magic packet не поддержан,
# sleep proxy в сети нет) — его будит первое нажатие клавиши через приёмник Bolt (0.4 с).
# Поэтому повторяем: первая попытка может уйти в никуда, а вторая-третья поймают его уже
# проснувшимся и поставят удержание дисплея. Основной цикл при этом не ждёт ни секунды.
# Отменяемая: pid субшелла хранится в MB_BG, и любое следующее событие его гасит. Иначе
# субшелл живёт до минуты, накапливается по несколько штук и ставит удержание уже после того,
# как владелец вернулся на mini. Внутри тоже проверяем probe: клавиатура вернулась — выходим.
MB_BG=""
mb_wake_bg() {
  [ -n "$MB_BG" ] && kill "$MB_BG" 2>/dev/null
  ( for i in 1 2 3 4; do
      [ "$(probe)" = "1" ] && exit 0          # вернулись на mini, будить больше некого
      if mb_wake; then
        if [ "$i" -gt 1 ]; then
          log "[уход] макбук отозвался с попытки $i"
          # Пока он спал, LG мог сам уйти на живой вход — перевыставляем, если мы ещё на макбуке.
          [ "$(probe)" = "0" ] && ddc_local "$IN_MB"
        fi
        exit 0
      fi
      sleep 3
    done
    log "[уход] макбук молчит по SSH — вероятно спит, проснётся от клавиши" ) &
  MB_BG=$!
}

# КОД ВОЗВРАТА m1ddc НИЧЕГО НЕ ЗНАЧИТ — прежняя проверка была фикцией.
# Замер 14.08 на mini по HDMI: 100 подряд `m1ddc get contrast` при реальном значении 50 —
# код возврата 0 в 100 случаях из 100, но верное значение вернулось лишь 69 раз, остальное
# мусор (0, 18, 136, 512, 4608, 13040, 25600, 28296, 34818, 65280). Значит `if "$DDC" set ...`
# было истинно ВСЕГДА, ретраи не срабатывали ни разу, а строка «ВНИМАНИЕ: DDC не прошёл»
# не могла появиться в принципе (grep -c по всему логу: 0).
# Прочитать текущий вход и проверить результат нечем: в m1ddc HEAD есть только
# get luminance/contrast/red/green/blue, команды get input-alt не существует.
# Поэтому вместо ложной проверки — избыточность: три посылки вместо двух.
# При наблюдаемых ~25-30 % потерь на пакет шанс, что не пройдёт ни одна, падает с ~8 % до ~2 %.
# Цена: +0,15 с к переключению и один лишний цикл hotplug на mini.
ddc_local() {
  local want="$1" i
  for i in 1 2 3; do
    [ "$i" -gt 1 ] && sleep 0.15
    "$DDC" set input-alt "$want" >/dev/null 2>&1
  done
  return 0
}
ddc_remote() { mb_ssh "$MB_DDC set input-alt $1"; }

probe() { "$BLUEUTIL" --is-connected "$KB" 2>/dev/null; }

# В фоне: при недоступном макбуке блокирующая проверка глушила опрос клавиатуры на 10 секунд
# после каждого перезапуска агента.
( mb_ssh 'true' && log "SSH-мастер поднят: $MB_ACTIVE" || log "макбук недоступен" ) &

state=$(probe)
case "$state" in 0|1) ;; *) state=1 ;; esac
log "старт, состояние=$state"

# Выравниваем вход под фактическое положение клавиатуры — но ТОЛЬКО если состояние
# разошлось с последним выставленным или отметка протухла.
# Цикл ниже реагирует только на СМЕНУ состояния, поэтому рассинхрон «клавиатура здесь,
# а картинка там» он бы не заметил вовсе — ровно это и случилось 14.08 после перезапуска
# агента с новыми кодами. Но безусловное выравнивание опасно с другой стороны: в плисте
# агента KeepAlive=true и ThrottleInterval=10, то есть любой аварийный выход скрипта
# гасил бы экран на ~3 с каждые 10 секунд. 14.08 два таких старта подряд (21:35:51 и 21:36:45)
# дали на mini по паре hotplug out/in каждый.
prev=$(cat "$STATEFILE" 2>/dev/null)
prev_mtime=$(stat -f %m "$STATEFILE" 2>/dev/null || echo 0)
prev_age=$(( $(date +%s) - prev_mtime ))
if [ "$prev" = "$state" ] && [ "$prev_age" -lt 300 ]; then
  log "  вход уже выровнен ($state), DDC не трогаю"
else
  if [ "$state" = "1" ]; then ddc_local "$IN_MINI"; else ddc_local "$IN_MB"; fi
fi
printf '%s' "$state" > "$STATEFILE"

hold_ts=0
while true; do
  sleep "$POLL"

  # Продление удержания — БЕЗУСЛОВНО, а не только когда клавиатура на макбуке.
  # Условие «держать» = «макбук на питании», и проверяется оно на самом макбуке внутри mb_hold.
  # В фоне: даже если макбук недоступен, mb_ssh потратит до 10 с в субшелле, а основной цикл
  # не ждёт ни секунды. Накопления субшеллов быть не может: 10 с < HOLD_RENEW.
  nowsec=$(date +%s)
  if [ $(( nowsec - hold_ts )) -ge "$HOLD_RENEW" ]; then
    hold_ts=$nowsec
    ( mb_hold ) >/dev/null 2>&1 &
  fi

  now=$(probe)
  case "$now" in 0|1) ;; *) continue ;; esac
  [ "$now" = "$state" ] && continue

  t0=$(date +%s)
  sleep "$SETTLE"
  confirm=$(probe)
  [ "$confirm" != "$now" ] && { log "дребезг ($state->$now->$confirm), игнор"; continue; }
  state=$now
  printf '%s' "$state" > "$STATEFILE"

  if [ "$now" = "0" ]; then
    # Ушли на макбук. Монитор переключаем ВСЕГДА и первым делом: DDC-команду шлёт сам mini,
    # от состояния макбука она не зависит вообще. Раньше здесь стоял гейт «переключаю только
    # если прошёл SSH» — с ним спящий макбук означал бы, что клавиатура уехала, а картинка
    # осталась от mini, то есть печать вслепую. Хуже, чем несколько секунд черноты.
    # Побудка идёт параллельно и цикл не блокирует.
    hold_ts=$(date +%s)
    mb_wake_bg
    ddc_local "$IN_MB"
    log "[уход] монитор -> макбук (USB-C) за $(( $(date +%s) - t0 ))с"
  else
    # Вернулись: Mac mini не спит и всегда рисует, будить нечего.
    # Резервная посылка с макбука УБРАНА: на спящем макбуке она висела до 18 с и, когда он
    # просыпался от клавиши, шла ПОВЕРХ уже сделанного следующего ухода — монитор уезжал
    # обратно на HDMI при клавиатуре на макбуке. За всё время наблюдений эта страховка не
    # сработала ни разу, а DDC-канал mini не отваливался даже после часа на неактивном входе.
    # Удержание НЕ снимаем: макбук остаётся в доке на питании, и мы хотим, чтобы он не спал.
    # Снимет его гейт по питанию в mb_hold, когда владелец отключит адаптер (см. блок выше).
    [ -n "$MB_BG" ] && kill "$MB_BG" 2>/dev/null; MB_BG=""
    ddc_local "$IN_MINI"
    log "[возврат] монитор -> mini (HDMI) за $(( $(date +%s) - t0 ))с"
  fi
done
