#!/bin/bash
# kvm-follow — монитор следует за клавиатурой MX Keys Mini.
#
# МЕХАНИЗМ. Монитор (LG UltraWide, семейство WQ) НЕ слушает стандартный VCP 0x60:
# все коды из его же capabilities (17/18/15) вход не меняют, дают лишь мерцание.
# Вход у новых LG переключается ПРОПРИЕТАРНЫМ регистром 0xF4, отправленным на I2C
# адрес 0x50 вместо 0x51 — в m1ddc это команда `set input-alt`.
# ВАЖНО: brew-релиз m1ddc 1.2.0 эту команду имеет, но она СЛОМАНА (неверная
# контрольная сумма и обнулённый старший байт значения). Нужен HEAD (PR #52).
# Здесь используется бинарник HEAD, собранный на макбуке: ~/bin/m1ddc.
# Коды проверены вживую: 144 (0x90) = HDMI, 465 (0x01D1) = USB-C. Какая машина на каком входе —
# см. IN_MINI/IN_MB ниже, это единственное место, где раскладка задаётся.
# Старший байт 0x01 в 465 — как раз то, что обрезала сломанная версия.
#
# Гашение экранов, прогрев и ожидание автопоиска больше не нужны: раньше это был
# обходной путь вокруг «неработающего» DDC. Переключение теперь ~1-2 с вместо 12-20.
#
# ДЕТЕКТ. Только на Mac mini: blueutil по ИМЕНИ устройства (по MAC-адресу blueutil
# ошибочно отдаёт 0). На макбуке клавиатура приходит через Bolt, а ресивер держит
# 3 HID-интерфейса постоянно — ioreg/hidutil не меняются, детектировать нечем.

KB="MX Keys Mini"
# РАСКЛАДКА: Mac mini на HDMI, MacBook на USB-C. 14.08 их временно меняли местами — из-за
# версии «неактивный USB-C роняет линк», которая НЕ подтвердилась (макбук держал неактивный
# USB-C по 16 минут, а дисплей терял из-за clamshell-сна на батарее). Вернули обратно, потому
# что у mini на USB-C канал управления терял треть команд (28 из 40 против почти 40 из 40 по
# HDMI) и частота падала до 50 Гц. Сон лечится ассерцией caffeinate -s в mb_wake, а не кабелями.
IN_MINI=144            # HDMI  (0x90)  — Mac mini
IN_MB=465              # USB-C (0x1D1) — макбук

MB_USER="semenmoshkin"
MB_HOSTS=("MacBook-Pro-2.local" "192.168.0.118")
SSH_KEY="/Users/semenmoshkin/.ssh/kvm_macbook"

POLL=0.3               # период опроса
SETTLE=0.3             # подтверждение против дребезга BT

DDC="/Users/semenmoshkin/bin/m1ddc"        # HEAD-сборка, с рабочим input-alt
MB_DDC="/opt/homebrew/bin/m1ddc"           # на макбуке тоже HEAD
BLUEUTIL=/opt/homebrew/bin/blueutil
LOG=/tmp/kvm-follow.log

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# ServerAlive* обязательны с тех пор, как макбуку разрешено спать: ConnectTimeout покрывает
# только установление соединения, а сеанс через УЖЕ ЖИВОЙ мастер-сокет к уснувшему хосту висит
# неограниченно и заморозил бы весь цикл. Теперь такой сеанс отваливается за 8-13 с (замерено).
# ControlPersist укорочен со 15 минут до 2: меньше шансов наткнуться на протухший сокет.
SSH_OPTS=(-i "$SSH_KEY" -o ConnectTimeout=5 -o BatchMode=yes
          -o ServerAliveInterval=3 -o ServerAliveCountMax=2
          -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
          -o ControlMaster=auto -o ControlPath=/tmp/kvm-ssh-%h -o ControlPersist=120)

MB_ACTIVE=""

mb_ssh() {
  local h
  for h in "${MB_ACTIVE}" "${MB_HOSTS[@]}"; do
    [ -z "$h" ] && continue
    if ssh "${SSH_OPTS[@]}" "$MB_USER@$h" "$1" >/dev/null 2>&1; then
      MB_ACTIVE="$h"; return 0
    fi
  done
  MB_ACTIVE=""; return 1
}

# Разбудить макбук и удержать его дисплей, пока мы на нём: иначе монитор переключится
# на USB-C и покажет чёрный экран. -u будит (с -t 1 не будит вообще), -d удерживает —
# powerd иначе отпускает дисплей уже через 30 секунд.
#
# Оба удержания БЕССРОЧНЫЕ и снимаются при возврате (mb_release). Пробовали самоистекающее
# -t 900 — ошибка: сеансов работы за макбуком длиннее 15 минут 7 из 60, вплоть до 6,7 часов,
# а после истечения дисплей гаснет по таймеру, и это второй путь в clamshell-сон
# (19 пар «Display is turned off -> Clamshell Sleep» в логах, 11 из них на питании).
#
# Ставим идемпотентно и БЕЗ pkill -f: шаблон подстроки матчит удалённые шеллы параллельных
# ssh-сеансов (проверено), и наложившиеся вызовы убивали удержание друг у друга.
# Точное сравнение argv при точном имени процесса такого не допускает.
#
# ГЛАВНОЕ ЗДЕСЬ — caffeinate -s (PreventSystemSleep). Именно эта ассерция, и только она,
# отключает сон по закрытой крышке. Доказано логом powerd 14.08:
#   19:24:33.937 Created PreventSystemSleep
#   19:24:34.708 EvaluateClamshell. Disable : 1 because {..., assertions 1
#   19:24:35.038 ассерция снята -> Disable : 0
# caffeinate -d (PreventUserIdleDisplaySleep) в терм assertions НЕ входит и от clamshell-сна
# не спасает — он закрывает другой путь, гашение дисплея по таймеру. Нужны оба.
# ВАЖНО: -s действует только на питании (man caffeinate). Без адаптера макбук всё равно уснёт.
mb_wake() {
  mb_ssh 'nohup caffeinate -u -t 5 >/dev/null 2>&1 &
          have_d=0; have_s=0
          for p in $(pgrep -x caffeinate); do
            a="$(ps -o args= -p $p)"
            [ "$a" = "caffeinate -d" ] && have_d=1
            [ "$a" = "caffeinate -s" ] && have_s=1
          done
          if [ "$have_d" = "0" ]; then nohup caffeinate -d >/dev/null 2>&1 & fi
          if [ "$have_s" = "0" ]; then nohup caffeinate -s >/dev/null 2>&1 & fi
          exit 0'
}

# Снять удержание при возврате на mini: в сумку оно тогда не уезжает, а пока мы за макбуком —
# держится сколько нужно. В фоне: ответ нам не важен, а спящий макбук молчал бы секунд десять.
# С ПОВТОРАМИ: одной попытки мало. 14.08 в 19:21 макбук в этот момент уже спал, SSH не прошёл,
# и удержание провисело сиротой 45 минут, не давая ноутбуку гасить экран.
mb_release() {
  ( for i in 1 2 3 4; do
      mb_ssh 'for p in $(pgrep -x caffeinate); do
                a="$(ps -o args= -p $p)"
                if [ "$a" = "caffeinate -d" ] || [ "$a" = "caffeinate -s" ]; then kill $p; fi
              done
              exit 0' && exit 0
      sleep 5
    done
    log "[возврат] удержание на макбуке снять не удалось — он недоступен" ) >/dev/null 2>&1 &
}

# Побудка в фоне с повторами. Спящий макбук по сети не разбудить (magic packet не поддержан,
# sleep proxy в сети нет) — его будит первое нажатие клавиши через приёмник Bolt (0.4 с).
# Поэтому повторяем: первая попытка может уйти в никуда, а вторая-третья поймают его уже
# проснувшимся и поставят удержание дисплея. Основной цикл при этом не ждёт ни секунды.
# Отменяемая: pid субшелла хранится в MB_BG, и любое следующее событие его гасит. Иначе
# субшелл живёт до минуты, накапливается по несколько штук и ставит удержание уже после того,
# как владелец вернулся на mini. Внутри тоже проверяем probe: клавиатура вернулась — выходим.
MB_BG=""
mb_wake_bg() {
  [ -n "$MB_BG" ] && kill "$MB_BG" 2>/dev/null
  ( for i in 1 2 3 4; do
      [ "$(probe)" = "1" ] && exit 0          # вернулись на mini, будить больше некого
      if mb_wake; then
        if [ "$i" -gt 1 ]; then
          log "[уход] макбук отозвался с попытки $i"
          # Пока он спал, LG мог сам уйти на живой вход — перевыставляем, если мы ещё на макбуке.
          [ "$(probe)" = "0" ] && ddc_local "$IN_MB"
        fi
        exit 0
      fi
      sleep 3
    done
    log "[уход] макбук молчит по SSH — вероятно спит, проснётся от клавиши" ) &
  MB_BG=$!
}

# LG иногда глотает первую команду — шлём дважды. Плюс проверяем код возврата: m1ddc честно
# отвечает 1, когда дисплей ему недоступен (а такое бывает, когда наш вход неактивен и линк
# просел). Раньше вывод уходил в /dev/null и провал выглядел в логе как успех.
ddc_local() {
  local want="$1" i
  for i in 1 2 3; do
    if "$DDC" set input-alt "$want" >/dev/null 2>&1; then
      [ "$i" -gt 1 ] && log "  DDC: прошло с попытки $i"
      sleep 0.15
      "$DDC" set input-alt "$want" >/dev/null 2>&1
      return 0
    fi
    sleep 0.4
  done
  log "  ВНИМАНИЕ: DDC не прошёл трижды подряд (вход $want) — монитор мог не переключиться"
  return 1
}
ddc_remote() { mb_ssh "$MB_DDC set input-alt $1"; }

probe() { "$BLUEUTIL" --is-connected "$KB" 2>/dev/null; }

# В фоне: при недоступном макбуке блокирующая проверка глушила опрос клавиатуры на 10 секунд
# после каждого перезапуска агента.
( mb_ssh 'true' && log "SSH-мастер поднят: $MB_ACTIVE" || log "макбук недоступен" ) &

state=$(probe)
case "$state" in 0|1) ;; *) state=1 ;; esac
log "старт, состояние=$state"

# Выравниваем вход под фактическое положение клавиатуры. Цикл ниже реагирует только на СМЕНУ
# состояния, поэтому рассинхрон «клавиатура здесь, а картинка там» он бы не заметил вовсе —
# ровно это и случилось 14.08 после перезапуска агента с новыми кодами.
if [ "$state" = "1" ]; then ddc_local "$IN_MINI"; else ddc_local "$IN_MB"; fi

while true; do
  sleep "$POLL"
  now=$(probe)
  case "$now" in 0|1) ;; *) continue ;; esac
  [ "$now" = "$state" ] && continue

  t0=$(date +%s)
  sleep "$SETTLE"
  confirm=$(probe)
  [ "$confirm" != "$now" ] && { log "дребезг ($state->$now->$confirm), игнор"; continue; }
  state=$now

  if [ "$now" = "0" ]; then
    # Ушли на макбук. Монитор переключаем ВСЕГДА и первым делом: DDC-команду шлёт сам mini,
    # от состояния макбука она не зависит вообще. Раньше здесь стоял гейт «переключаю только
    # если прошёл SSH» — с ним спящий макбук означал бы, что клавиатура уехала, а картинка
    # осталась от mini, то есть печать вслепую. Хуже, чем несколько секунд черноты.
    # Побудка идёт параллельно и цикл не блокирует.
    mb_wake_bg
    ddc_local "$IN_MB"
    log "[уход] монитор -> макбук (USB-C) за $(( $(date +%s) - t0 ))с"
  else
    # Вернулись: Mac mini не спит и всегда рисует, будить нечего.
    # Резервная посылка с макбука УБРАНА: на спящем макбуке она висела до 18 с и, когда он
    # просыпался от клавиши, шла ПОВЕРХ уже сделанного следующего ухода — монитор уезжал
    # обратно на HDMI при клавиатуре на макбуке. За всё время наблюдений эта страховка не
    # сработала ни разу, а DDC-канал mini не отваливался даже после часа на неактивном входе.
    [ -n "$MB_BG" ] && kill "$MB_BG" 2>/dev/null; MB_BG=""
    ddc_local "$IN_MINI"
    mb_release
    log "[возврат] монитор -> mini (HDMI) за $(( $(date +%s) - t0 ))с"
  fi
done
