# kvm-follow configuration — copy to ~/.config/kvm-follow/config and edit.
# Plain shell, sourced by the script. Every value below is a default you may drop.

# Exact Bluetooth name of the keyboard, as printed by:  blueutil --paired
# Must be matched by NAME. blueutil --is-connected with a MAC address returns 0
# even when the device is connected.
KEYBOARD="MX Keys Mini"

# Which m1ddc command switches the input:
#   input-alt  LG service sidechannel (DDC2AB, source address 0x50) — recent LG panels
#   input      standard VCP 0x60 — Dell, Samsung, BenQ, ASUS, older LG, most others
# If your monitor is not a recent LG, try `input` FIRST: it is the documented path and
# does not touch the manufacturer's service channel at all.
DDC_CMD="input-alt"

# Input codes. Note that they depend on DDC_CMD — the two registers use different
# numbering, so a code from one table means nothing to the other.
#
# Standard VCP 0x60 (DDC_CMD=input):
#   15 DisplayPort 1 | 16 DisplayPort 2 | 17 HDMI 1 | 18 HDMI 2 | 27 USB-C
#
# LG sidechannel (DDC_CMD=input-alt), per the ddcutil wiki:
#   144 = 0x90  HDMI 1        | 145 = 0x91  HDMI 2
#   208 = 0xD0  DisplayPort 1 | 209 = 0xD1  DisplayPort 2 | 210 = 0xD2  USB-C
#
# ...but these tables are not reliable across models. On the LG UltraWide this was
# built on, USB-C answers to 465 = 0x1D1, not to the documented 210. That two-byte
# value is also exactly what the broken Homebrew build of m1ddc cannot send.
# Verify yours with tools/probe-inputs.sh.
INPUT_HOST=144        # the machine running this script
INPUT_PEER=465        # the other machine

# The other machine. Hosts are tried in order; the first one that answers is cached
# for the session, so put the mDNS name first and a static IP as a fallback.
PEER_USER="youruser"
PEER_HOSTS="peer.local 192.168.0.10"
SSH_KEY="$HOME/.ssh/kvm_peer"

# m1ddc must be a HEAD build on BOTH machines — see README.
DDC="/opt/homebrew/bin/m1ddc"
PEER_DDC="/opt/homebrew/bin/m1ddc"
BLUEUTIL="/opt/homebrew/bin/blueutil"

# Timing. POLL is cheap (blueutil call, no I/O), SETTLE is the debounce window:
# Bluetooth reports a disconnect-reconnect flap when Easy-Switch changes channel.
POLL=0.3
SETTLE=0.3

# How long to keep the peer's display awake after switching to it, in seconds.
# The hold is deliberately not released on switch-back — an awake peer switches ~1.5 s
# faster. 0 means "hold forever", which also means the peer will never sleep again
# until it reboots. 1800 is a sane bound if the peer is a laptop you carry away.
WAKE_HOLD=1800

LOG="/tmp/kvm-follow.log"
